# Composer-managed dependencies. Reinstall with `ddev composer install`.
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/web/autoload.php
/web/sites/*/settings.local.php

# Drupal-generated / uploaded files.
/web/sites/*/files/

# Local environment and secrets.
.env
.env.local
*.local.yml

# Database dumps.
*.sql
*.sql.gz

# OS / editor cruft.
.DS_Store
.idea/
.vscode/
*.swp

# PHPUnit / tooling output.
/phpunit.xml
.phpunit.result.cache
/tests/report/
