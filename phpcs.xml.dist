<?xml version="1.0"?>
<ruleset name="AvenricHealth">
    <description>Drupal coding standards for Avenric Health custom code.</description>

    <file>web/modules/custom</file>
    <file>web/themes/custom</file>

    <arg name="extensions" value="php,module,inc,install,test,profile,theme,info,txt,md,yml"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="Drupal"/>
    <rule ref="DrupalPractice"/>

    <config name="drupal_core_version" value="11"/>
</ruleset>
